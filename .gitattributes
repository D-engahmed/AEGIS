# Normalize line endings. Shell scripts must stay LF or the Linux containers
# break at the interpreter line; Python/YAML are safe as LF as well.
* text=auto

*.py text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
